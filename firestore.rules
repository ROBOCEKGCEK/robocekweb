rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /custom_forms/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
